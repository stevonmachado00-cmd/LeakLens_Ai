# Backend
ENVIRONMENT=development
# Use an absolute or repo-relative canonical path. Example (recommended):
# DATABASE_URL=sqlite:///backend/leaklens.db
# Or absolute on Windows: sqlite:///C:/full/path/to/LeakLensAI/backend/leaklens.db
DATABASE_URL=sqlite:///backend/leaklens.db
# Use a unique value of at least 32 characters for production.
SECRET_KEY=replace-with-a-unique-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

